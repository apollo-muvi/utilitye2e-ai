# utilitye2e-ai environment variables
# Copy to .env and fill in your values

# ─── LLM API Keys (set the one you use) ───
# OpenRouter (recommended — access all models via one key)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# GLM (z.ai / ZhipuAI) — https://z.ai
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local, no key needed) — https://ollama.com
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434

# ─── Database Connection ───
DB_CONNECTION=postgresql://user:password@localhost:5432/dbname

# ─── Target Web App Auth ───
TARGET_BASE_URL=http://localhost:3001
TARGET_USERNAME=admin
TARGET_PASSWORD=admin

# ─── Flask ───
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
SECRET_KEY=change-me-in-production
